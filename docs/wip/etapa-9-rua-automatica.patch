+      const key = tileKey(next.x, next.y)
+      if (free(next.x, next.y) && !previous.has(key)) { previous.set(key, tileKey(tile.x, tile.y)); queue.push(next) }
+    }
+  }
+  return { error: 'Não há caminho livre até a rua. Libere espaço ou desenhe a rua.' }
