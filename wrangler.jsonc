{
  "name": "cityou",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-09",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html", "/city", "/city.html", "/world", "/world.html"]
  },
  // Viagens entre locais ficam fechadas por enquanto. Para abrir, troque para "true" (aqui e em previews).
  "vars": { "TRAVEL_OPEN": "false" },
  "durable_objects": {
    "bindings": [{ "name": "DEMO_SESSIONS", "class_name": "DemoSession" }]
  },
  "migrations": [{ "tag": "demo-v1", "new_sqlite_classes": ["DemoSession"] }],
  "observability": {
    "enabled": true
  },
  "previews": {
    "vars": { "TRAVEL_OPEN": "false" },
    "durable_objects": {
      "bindings": [{ "name": "DEMO_SESSIONS", "class_name": "DemoSession" }]
    }
  }
  // O banco D1 ainda não está ligado em produção: falta criar o banco e pôr aqui
  // "d1_databases": [{ "binding": "DB", "database_name": "cityou", "database_id": "<id>", "migrations_dir": "migrations" }]
  // Até lá, GET /api/health responde db: "not_configured". Os testes usam wrangler.test.jsonc.
}
