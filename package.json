{
  "name": "cityou",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5177",
    "build": "vite build && vite build --config vite.landing.config.js && vite build --config vite.terrain.config.js",
    "preview": "vite preview --host 127.0.0.1 --port 5177",
    "start": "python -m backend",
    "test": "node --test tests/progression.test.mjs tests/world.test.mjs tests/game-rules.test.mjs tests/glb-material.test.mjs tests/terrain.test.mjs tests/terrain-scene.test.mjs tests/city-models.test.mjs tests/city-look.test.mjs",
    "test:map": "node tools/verify-map-plan.mjs",
    "test:ui": "node tools/personal-playtest.mjs && node tools/browser-playtest.mjs",
    "test:world": "node tools/world-playtest.mjs",
    "test:tres": "node tools/tres-lab-check.mjs",
    "test:terrain": "node tools/terrain-check.mjs",
    "terrain:data": "node tools/terrain-data.mjs",
    "perf:world": "node tools/world-perf.mjs",
    "perf:world-frame": "node tools/world-frame-bench.mjs",
    "perf:city": "node tools/city-frame-bench.mjs",
    "test:worker": "node --test tests/worker.test.mjs",
    "dev:worker": "wrangler dev --port 8787",
    "perf:api": "node tools/api-perf.mjs"
  },
  "dependencies": {
    "@tresjs/core": "5.10.1",
    "gsap": "^3.12.5",
    "mitt": "^3.0.1",
    "pinia": "^3.0.3",
    "three": "0.172.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "playwright": "1.62.1",
    "vite": "^6.4.6",
    "wrangler": "^4.160.0"
  },
  "description": "Organizacao pessoal gamificada e cidade 3D inspirada no Rio de Janeiro"
}
