    "perf:world": "node tools/world-perf.mjs",
    "test:worker": "node --test tests/worker.test.mjs",
    "dev:worker": "wrangler dev --port 8787",
    "perf:api": "node tools/api-perf.mjs"
  },
  "dependencies": {
    "gsap": "^3.12.5",
